__lua__
-- Basic starter template --
function template()
  function _init()
  end

  function _update()
  end

  function _draw()
    cls(1)
  end
end

-- onClick function --

-- k = 0,1,2,3 4,5
-- f = function to run
function onClick(k, f)
  if btn(k) then
    f()
  end
end

-- Basic collision function between object and flag --

-- o = {x, y, w, h}
-- f = flag number
function collide(o, f)
  local tx = flr(o.x / 8)
  local ty = flr(o.y / 8)
  local tw = flr((o.x + o.w * 8 - 1) / 8)
  local th = flr((o.y + o.h * 8 - 1) / 8)

  local a = fget(mget(tx, ty), f)
  local b = fget(mget(tw, ty), f)
  local c = fget(mget(tx, th), f)
  local d = fget(mget(tw, th), f)

  return (a or b or c or d)
end

